# Пример переменных окружения для бэкенда Citrus.
# Скопируйте в .env (он в .gitignore) для локали ИЛИ задайте в панели деплоя.
# Секреты НИКОГДА не коммитим в репозиторий.

# --- База данных (PostgreSQL / Supabase) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=citrus
DB_USER=citrus
DB_PASSWORD=change-me
# true для Supabase/удалённой БД с SSL (для *.supabase включается автоматически)
DB_SSL=false

# --- Безопасность ---
# Длинная случайная строка. ОБЯЗАТЕЛЬНО задать в продакшене.
JWT_SECRET=replace-with-a-long-random-secret
# Email модератора статей сообщества
ADMIN_EMAIL=you@example.com

# --- Cloudinary (хранение фото) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Необязательно — по умолчанию строится из CLOUDINARY_CLOUD_NAME
# CLOUDINARY_UPLOAD_URL=https://api.cloudinary.com/v1_1/your-cloud-name/image/upload

# --- GigaChat (ИИ-чат и инсайты) ---
GIGACHAT_AUTHORIZATION_KEY=your-gigachat-authorization-key
