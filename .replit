modules = ["dart-3.10", "postgresql-16"]
[userenv]

[userenv.shared]
PORT = "5000"

[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/dart_frog_backend && dart run server.dart"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5050
externalPort = 3000

[deployment]
deploymentTarget = "vm"
run = ["bash", "-c", "cd apps/dart_frog_backend && ./server"]
build = ["bash", "-c", "cd apps/dart_frog_backend && dart pub get && dart compile exe server.dart -o server"]
